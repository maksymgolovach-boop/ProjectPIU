<Window x:Class="NivelWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NivelWPF"
        mc:Ignorable="d"
        Title="Orarul personal" Height="560" Width="1200" Background="white"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style x:Key="SearchBox"  TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2C2C2A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D3D1C7"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#B4B2A9"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#185FA5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <local:DateToColorConverter x:Key="DateToColor"/>
        <local:DateToLightColorConverter x:Key="DateToLightColor"/>
        <local:ActivityTypeToRomanianConverter x:Key="TypeToRomanian"/>
        <local:ActivityTypeToColorConverter x:Key="TypeToColor"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- PANELUL LISTEI DE ACTIVITATI -->
        <Grid Grid.Column="0"
                    Background="#f5f4ed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Height="Auto">
                <Label Content="ACTIVITATI" Foreground="#7a7872"
                   HorizontalAlignment="left"
                   FontFamily="Bahnschrift Light"
                   Margin="5 5 0 5"
                   FontSize="20"
                   Grid.Row="0"/>
                <Grid Grid.Row="0" Margin="10 0 10 0">
                    <TextBox x:Name="SearchActivities" Style="{StaticResource SearchBox}" TextChanged="SearchActivities_TextChanged"/>

                    <TextBlock Text="Cauta activitati..." 
                               IsHitTestVisible="False" 
                               Foreground="Gray" 
                               VerticalAlignment="Center"
                               Margin="15 0 0 0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <!-- Shows the text only when the TextBox is empty -->
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchActivities}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>


            <!-- LISTA DE ACTIVITATI -->

            <ListView x:Name="ActivityListView"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          Background="Transparent"
                          BorderThickness = "0"
                          HorizontalContentAlignment="Stretch"
                          Margin="10"
                          Grid.Row="1">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ActivityCard"
                                    BorderBrush="#E8E6DF"
                                    BorderThickness="0.5"
                                    CornerRadius="8"
                                    Background="White"
                                    Margin="0,0,0,10"
                                    Padding="14,12">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Adauga la orar" Click="MenuAddtoSched_Click"/>
                                    <MenuItem Header="Modifica" Click="MenuModify_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Sterge" Foreground="Red" Click="MenuDelete_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Colored left accent bar -->
                                <Border Grid.Column="0"
                                            Width="4"
                                            CornerRadius="2"
                                            Margin="0,0,12,0"
                                            Background="{Binding type, Converter={StaticResource TypeToColor}}"/>

                                <!-- Activity info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding name}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Foreground="#2C2C2A"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Ellipse Width="7" Height="7"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,5,0"
                                                 Fill="{Binding type, Converter={StaticResource TypeToColor}}"/>
                                        <TextBlock Text="{Binding type, Converter={StaticResource TypeToRomanian}}"
                                                   FontSize="12"
                                                   Foreground="{Binding type, Converter={StaticResource TypeToColor}}"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding description}"
                                               FontSize="12"
                                               Foreground="#888780"
                                               Margin="0,3,0,0"
                                               MaxWidth="175"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <!-- Empty state message -->
            <TextBlock x:Name="EmptyActivitiesMessage"
                               Text="Nu aveti activitati in lista"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               FontFamily="Segoe UI"
                               Foreground="#888780"
                               Visibility="Collapsed"
                               Grid.Row="1"/>

            <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Stretch">
                <Button Content="+ Noua activitate" Style="{StaticResource DashedButtonStyle}" Margin="10" Click="AddActivityWindow" HorizontalAlignment="Stretch"/>
                <Label Content="LEGENDA"
                           Margin="5" HorizontalAlignment="Left"/>

                <ScrollViewer  MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TypesLegend" Margin="15 0 0 0 " HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                    <Ellipse Width="12" Height="12" 
                                                     Fill="{Binding Type, Converter={StaticResource TypeToColor}}" 
                                                     VerticalAlignment="Center" />

                                    <TextBlock Text="{Binding DisplayName}" 
                                                       Foreground="#333333" 
                                                       FontSize="14" 
                                                       Margin="12,0,0,0" 
                                                       VerticalAlignment="Center" />

                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

        </Grid>


        <Rectangle Width="1" Fill="#dedddd" HorizontalAlignment="Right"/>

        <!-- REGIUNEA CALENDAR -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Zile -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="Luni" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="Marti" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Grid.Column="3" Text="Miercuri" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Grid.Column="4" Text="Joi" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Grid.Column="5" Text="Vineri" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Grid.Column="6" Text="Sambata" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Grid.Column="7" Text="Duminica" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
            </Grid>

            <ScrollViewer  Grid.Row="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Ore -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>

                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="08:00" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Row="1" Text="09:00" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Row="2" Text="10:00" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Row="3" Text="11:00" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Row="4" Text="12:00" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Row="5" Text="13:00" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Row="6" Text="14:00" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Row="7" Text="15:00" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Row="8" Text="16:00" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Row="9" Text="17:00" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Row="10" Text="18:00" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Row="11" Text="19:00" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Row="12" Text="20:00" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Row="13" Text="21:00" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Row="14" Text="22:00" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock Grid.Row="15" Text="23:00" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                    </Grid>
                    <Grid Grid.Column="1" MouseRightButtonDown="Schedule_MouseDown" Background="Transparent">
                        <Grid IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.RowSpan="16" Grid.Column="0" BorderBrush="#D3D3D3" BorderThickness="0,0,1,0"/>
                            <Border Grid.Row="0" Grid.RowSpan="16" Grid.Column="1" BorderBrush="#D3D3D3" BorderThickness="0,0,1,0"/>
                            <Border Grid.Row="0" Grid.RowSpan="16" Grid.Column="2" BorderBrush="#D3D3D3" BorderThickness="0,0,1,0"/>
                            <Border Grid.Row="0" Grid.RowSpan="16" Grid.Column="3" BorderBrush="#D3D3D3" BorderThickness="0,0,1,0"/>
                            <Border Grid.Row="0" Grid.RowSpan="16" Grid.Column="4" BorderBrush="#D3D3D3" BorderThickness="0,0,1,0"/>
                            <Border Grid.Row="0" Grid.RowSpan="16" Grid.Column="5" BorderBrush="#D3D3D3" BorderThickness="0,0,1,0"/>

                            <Border Grid.Row="0" Grid.ColumnSpan="7" BorderBrush="#D3D3D3" BorderThickness="0,0,0,1"/>
                            <Border Grid.Row="1" Grid.ColumnSpan="7" BorderBrush="#D3D3D3" BorderThickness="0,0,0,1"/>
                            <Border Grid.Row="2" Grid.ColumnSpan="7" BorderBrush="#D3D3D3" BorderThickness="0,0,0,1"/>
                            <Border Grid.Row="3" Grid.ColumnSpan="7" BorderBrush="#D3D3D3" BorderThickness="0,0,0,1"/>
                            <Border Grid.Row="4" Grid.ColumnSpan="7" BorderBrush="#D3D3D3" BorderThickness="0,0,0,1"/>
                            <Border Grid.Row="5" Grid.ColumnSpan="7" BorderBrush="#D3D3D3" BorderThickness="0,0,0,1"/>
                            <Border Grid.Row="6" Grid.ColumnSpan="7" BorderBrush="#D3D3D3" BorderThickness="0,0,0,1"/>
                            <Border Grid.Row="7" Grid.ColumnSpan="7" BorderBrush="#D3D3D3" BorderThickness="0,0,0,1"/>
                            <Border Grid.Row="8" Grid.ColumnSpan="7" BorderBrush="#D3D3D3" BorderThickness="0,0,0,1"/>
                            <Border Grid.Row="9" Grid.ColumnSpan="7" BorderBrush="#D3D3D3" BorderThickness="0,0,0,1"/>
                            <Border Grid.Row="10" Grid.ColumnSpan="7" BorderBrush="#D3D3D3" BorderThickness="0,0,0,1"/>
                            <Border Grid.Row="11" Grid.ColumnSpan="7" BorderBrush="#D3D3D3" BorderThickness="0,0,0,1"/>
                            <Border Grid.Row="12" Grid.ColumnSpan="7" BorderBrush="#D3D3D3" BorderThickness="0,0,0,1"/>
                            <Border Grid.Row="13" Grid.ColumnSpan="7" BorderBrush="#D3D3D3" BorderThickness="0,0,0,1"/>
                            <Border Grid.Row="14" Grid.ColumnSpan="7" BorderBrush="#D3D3D3" BorderThickness="0,0,0,1"/>
                        </Grid>

                    </Grid>

                    <!-- CALENDAR -->
                    <ItemsControl x:Name="Schedule" Grid.Column="1" ItemsSource="{Binding DisplaySchedule}" Panel.ZIndex="1">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                    </Grid.RowDefinitions>
                                </Grid>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Grid.Column" Value="{Binding DayColumn}"/>
                                <Setter Property="Grid.Row" Value="{Binding StartRow}"/>
                                <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding type, Converter={StaticResource TypeToColor}}" BorderBrush="#dedddd" 
                                BorderThickness="1" Margin="1" CornerRadius="2" Padding="5">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="InfoMenuItem" Header="Info" Click="InfoInSchedule_Click"/>
                                            <Separator />
                                            <MenuItem Header="Elimina" Click="DeleteFromSchedule_Click" Foreground="Red" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" Foreground="White"/>
                                        <TextBlock FontSize="10" Foreground="White">
                                            <Run Text="{Binding Sched.start_time, StringFormat='{}{0:HH:mm}'}"/>
                                            <Run Text="-"/>
                                            <Run Text="{Binding Sched.end_time, StringFormat='{}{0:HH:mm}'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Popup for custom info -->
                    <Popup x:Name="CustomInfoPopup" PlacementTarget="{Binding ElementName=InfoMenuItem}" 
                        Placement="Center" StaysOpen="False" AllowsTransparency="True"
                           MaxHeight="300"
                           MaxWidth="450">
                        <Border x:Name="PopUpBorder" Background="White" CornerRadius="8" Padding="12" BorderBrush="{Binding type, Converter={StaticResource TypeToColor}}" BorderThickness="2">
                            <StackPanel>
                                <StackPanel.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Margin" Value="2"/>
                                    </Style>
                                </StackPanel.Resources>
                                
                                <TextBlock x:Name="NameInfo" FontWeight="Bold" Foreground="Black"/>
                                <TextBlock x:Name="TypeInfo" Foreground="{Binding type, Converter={StaticResource TypeToColor}}"/>
                                <TextBlock x:Name="DayTimeInfo" Foreground="Black"/>
                                <Border Background="#f5f4ed" CornerRadius="4" Padding="4" BorderThickness="1" BorderBrush="{Binding type, Converter={StaticResource TypeToColor}}"
                                        Margin="2">
                                    <ScrollViewer>
                                        <TextBlock x:Name="DescriptionInfo" Foreground="Black"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- PANELUL DEADLINES -->
        <Grid Grid.Column="2"
              Background="#f5f4ed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Content="TERMENI" Foreground="#7a7872"
                       HorizontalAlignment="left"
                       FontFamily="Bahnschrift Light"
                       Margin="0 5"
                       FontSize="20"
                       Grid.Row="0"/>

                <Grid Grid.Row="1">
                    <ListView x:Name="DeadlinesListView"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      Background="Transparent"
                      BorderThickness="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <!-- Outer card -->
                                <Border Background="White"
                                    CornerRadius="6 5 5 6"
                                    Margin="0,6,0,6"
                                    Width="200"
                                    BorderBrush="#E8E6DF"
                                    BorderThickness="0.5">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Info" Click="MenutInfoDeadline_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Sterge" Foreground="Red" Click="MenuDeleteDeadline_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Colored left accent bar -->
                                        <Border Grid.Column="0"
                                            Background="{Binding DueDate, Converter={StaticResource DateToColor}}"
                                            CornerRadius="6,0,0,6"/>

                                        <!-- Card content -->
                                        <StackPanel Grid.Column="1" Margin="10">

                                            <!-- Title -->
                                            <TextBlock Text="{Binding Name}"
                                                FontFamily="Inter 18pt"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#2C2C2A"
                                                TextTrimming="CharacterEllipsis"
                                                Margin="0,0,0,3"/>

                                            <!-- Due date line -->
                                            <TextBlock FontFamily="Segoe UI"
                                                FontSize="11"
                                                Foreground="#888780"
                                                Margin="0,0,0,8">
                                                 <Run Text="Pana: "/>
                                                 <Run Text="{Binding DisplayDueDate, Mode=OneWay}"/>
                                            </TextBlock>

                                            <!-- Days-left pill badge -->
                                            <Border CornerRadius="5"
                                                HorizontalAlignment="Left"
                                                Background="{Binding DueDate, Converter={StaticResource DateToLightColor}}"
                                                Padding="8,3">

                                                <TextBlock Text="{Binding DisplayDaysLeft, Mode=OneWay}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   Foreground="{Binding DueDate, Converter={StaticResource DateToColor}}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <!-- Deadline Info Popup -->
                    <Popup x:Name="CustomInfoPopupDeadline" PlacementTarget="{Binding ElementName=InfoMenuItem}" 
   Placement="Center" StaysOpen="False" AllowsTransparency="True"
   MaxHeight="250"
   MaxWidth="300">

                        <Border x:Name="DeadlinePopUpBorder" Background="White" CornerRadius="8" Padding="12" BorderBrush="{Binding DueDate, Converter={StaticResource DateToColor}}" BorderThickness="2">
                            <StackPanel>
                                <StackPanel.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Margin" Value="2"/>
                                    </Style>
                                </StackPanel.Resources>

                                <TextBlock x:Name="DeadlineNameInfo" FontWeight="Bold" Foreground="Black"/>
                                <TextBlock x:Name="DeadlineDueDate" Foreground="{Binding DueDate, Converter={StaticResource DateToColor}}"/>
                                <TextBlock x:Name="DeadlineAsociatedActivity" Foreground="Black"/>
                                <Border Background="#f5f4ed" CornerRadius="4" Padding="4" BorderThickness="1" BorderBrush="{Binding DueDate, Converter={StaticResource DateToColor}}"
                Margin="2">
                                    <ScrollViewer>
                                        <TextBlock x:Name="DeadlineDescriptionInfo" Foreground="Black"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Empty state message -->
                    <TextBlock x:Name="EmptyDeadlinesMessage"
                               Text="Nu aveti termeni limita"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               FontFamily="Segoe UI"
                               Foreground="#888780"
                               Visibility="Collapsed"/>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button Content="+ Nou termen"
                        Style="{StaticResource DashedButtonStyle}"
                        Margin="10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Click="AddDeadlineWindow"/>
                    
                    <Border Background="#F4F3ED" Padding="20" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <StackPanel HorizontalAlignment="Stretch">

                            <TextBlock Text="Niveluri de urgență" 
                               FontWeight="Bold" 
                               Foreground="#84827D" 
                               FontSize="13" 
                               Margin="0,0,0,12" 
                               FontFamily="Segoe UI, Arial, sans-serif"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Ellipse Width="11" Height="11" Fill="#E3524C" VerticalAlignment="Center" Margin="0,0,12,0"/>
