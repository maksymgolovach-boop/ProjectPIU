<Window x:Class="NivelWPF.AddDirectlyToSchedule"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NivelWPF"
        mc:Ignorable="d"
        Title="Adaugare in orar"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F1EFE8">

    <Window.Resources>


        <!-- Base text style -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#2C2C2A"/>
        </Style>

        <!-- Section label style (uppercase muted label) -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#888780"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Field label style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#5F5E5A"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Input box style -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2C2C2A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D3D1C7"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#B4B2A9"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#185FA5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DatePicker style -->
        <Style TargetType="DatePicker">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2C2C2A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D3D1C7"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <!-- Cancel button style -->
        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#5F5E5A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#D3D1C7"
                                BorderThickness="0.5"
                                CornerRadius="8"
                                Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1EFE8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D3D1C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Add button style -->
        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#E6F1FB"/>
            <Setter Property="Background" Value="#185FA5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="18,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0C447C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#042C53"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Change button style -->
        <Style x:Key="ChangeButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#5F5E5A"/>
            <Setter Property="Background" Value="#F1EFE8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#D3D1C7"
                                BorderThickness="0.5"
                                CornerRadius="8"
                                Padding="18,6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1EFE8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <local:ActivityTypeToRomanianConverter x:Key="TypeToRomanian"/>
    </Window.Resources>

    <Border Background="White" CornerRadius="12">
        <StackPanel>


            <StackPanel Margin="10">


                <TextBlock Text="ACTIVITATE SELECTATA"
                           Style="{StaticResource SectionLabel}"/>


                <Border x:Name="ActivityCard"
                        BorderBrush="#E8E6DF"
                        BorderThickness="0.5"
                        CornerRadius="8"
                        Background="White"
                        Margin="0,0,0,20"
                        Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Colored left accent bar -->
                        <Border Grid.Column="0"
                                Width="4"
                                CornerRadius="2"
                                Margin="0,0,12,0"
                                Background="{Binding SelectedActivity.type, Converter={StaticResource TypeToColor}}"/>

                        <!-- Activity info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedActivity.name}"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="#2C2C2A"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="7" Height="7"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0"
                                         Fill="{Binding SelectedActivity.type, Converter={StaticResource TypeToColor}}"/>
                                <TextBlock Text="{Binding SelectedActivity.type, Converter={StaticResource TypeToRomanian}}"
                                           FontSize="12"
                                           Foreground="{Binding SelectedActivity.type, Converter={StaticResource TypeToColor}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedActivity.description}"
                                       FontSize="12"
                                       Foreground="#888780"
                                       Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        
                        <!-- Change button -->
                        <Button Grid.Column="2"
                                Content="Schimba"
                                Style="{StaticResource ChangeButton}"
                                Margin="5 10 10 10"
                                Click="changeActivity_Click"/>

                    </Grid>
                </Border>

                <!-- Divider -->
                <Border Height="0.5"
                        Background="#E8E6DF"
                        Margin="0,0,0,20"/>

                <!-- Section: Schedule details -->
                <TextBlock Text="INSCRIE IN ORAR"
                           Style="{StaticResource SectionLabel}"/>

                <!-- Day field (full width) -->
                <TextBlock Text="Ziua"
                           Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="DayPicker"
                            DisplayMemberPath="Day"
                            SelectedValuePath="Value"/>

                <!-- Start / End time row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Start time -->
                    <StackPanel Grid.Column="0" Grid.Row="0">
                        <TextBlock Text="Ora inceput"
                                   Style="{StaticResource FieldLabel}"
                                   HorizontalAlignment="Stretch"/>
                        <ComboBox x:Name="StartTimeBox"
                                  SelectionChanged="TimeBox_TextChanged"
                                  IsEditable="True"
                                  />
                    </StackPanel>

                    <!-- End time -->
                    <StackPanel Grid.Column="2" Grid.Row="0">
                        <TextBlock Text="Ora sfarsit"
                                   Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="EndTimeBox"
                            SelectionChanged="TimeBox_TextChanged"
                            IsEditable="True"/>
                    </StackPanel>
                    <Label Grid.Column="0" Grid.Row="2"
                           x:Name="TimeErrorLabel"
                           FontSize="11"
                           Foreground="#888780"
                           Margin="0,4,0,0"/>
                </Grid>

                <!-- Duration hint bar -->
                <Border Background="#F1EFE8"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏱  Duratie: "
                                   FontSize="12"
                                   Foreground="#5F5E5A"/>
                        <TextBlock x:Name="DurationText"
                                   Text="—"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="#2C2C2A"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Footer -->
            <Border BorderBrush="#E8E6DF"
                    BorderThickness="0,0.5,0,0"
                    Background="#F1EFE8"
                    Padding="20,14">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Style="{StaticResource CancelButton}"
                            Margin="0,0,8,0"
                            Click="Cancel_Click"/>
                    <Button Content="+ Adauga la orar"
                            Style="{StaticResource AddButton}"
                            Click="AddToSched_Click"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</Window>
