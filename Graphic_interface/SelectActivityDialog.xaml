<Window x:Class="NivelWPF.SelectActivityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NivelWPF"
        mc:Ignorable="d"
        Title="Selectare activitate"
        Width="520"
        Height="600"
        MinHeight="400"
        MinWidth="400"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F1EFE8">

    <Window.Resources>
        <local:ActivityTypeToRomanianConverter x:Key="TypeToRomanian"/>

        <!-- Base text style -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#2C2C2A"/>
        </Style>

        <!-- Section label style (uppercase muted label) -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#888780"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Field label style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#5F5E5A"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Cancel button style -->
        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#5F5E5A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#D3D1C7"
                                BorderThickness="0.5"
                                CornerRadius="8"
                                Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1EFE8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D3D1C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Confirm button style -->
        <Style x:Key="ConfirmButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#E6F1FB"/>
            <Setter Property="Background" Value="#185FA5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="18,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0C447C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#042C53"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Activity item style -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border"
                                Background="White"
                                BorderBrush="#E8E6DF"
                                BorderThickness="0.5"
                                Padding="0"
                                CornerRadius="8"
                                Margin="0,0,0,8">
                            <ContentPresenter Margin="12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8F7F4"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E6F1FB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#185FA5"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="12">
        <StackPanel Margin="20">
            <!-- Header -->
            <TextBlock Text="SELECTARE ACTIVITATE"
                       Style="{StaticResource SectionLabel}"/>

            <TextBlock Text="Alege o activitate din lista:"
                       Style="{StaticResource FieldLabel}"
                       Margin="0,0,0,15"/>

            <!-- Activities List -->
            <ListBox x:Name="ActivitiesListBox"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,20"
                     Height="400">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Colored left accent bar -->
                            <Border Grid.Column="0"
                                    Width="4"
                                    CornerRadius="2"
                                    Margin="0,0,12,0"
                                    Background="{Binding type, Converter={StaticResource TypeToColor}}"/>

                            <!-- Activity info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding name}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="#2C2C2A"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse Width="7" Height="7"
                                             VerticalAlignment="Center"
                                             Margin="0,0,5,0"
                                             Fill="{Binding type, Converter={StaticResource TypeToColor}}"/>
                                    <TextBlock Text="{Binding type, Converter={StaticResource TypeToRomanian}}"
                                               FontSize="12"
                                               Foreground="{Binding type, Converter={StaticResource TypeToColor}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding description}"
                                           FontSize="12"
                                           Foreground="#888780"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state message -->
            <TextBlock x:Name="EmptyMessage"
                       Text="Nu sunt activitati disponibile."
                       Foreground="#888780"
                       FontSize="13"
                       TextAlignment="Center"
                       Visibility="Collapsed"
                       Margin="0,180,0,180"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Anulare"
                        Style="{StaticResource CancelButton}"
                        Click="Cancel_Click"
                        Margin="0,0,10,0"/>
                <Button Content="Selectare"
                        Style="{StaticResource ConfirmButton}"
                        Click="Confirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
